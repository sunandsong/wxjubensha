/* 房间等待 —— 简洁方案：房间号是主角，玻璃卡 + 紫渐变主按钮（对齐设计稿） */

page { background: radial-gradient(85% 45% at 50% 0%, rgba(140, 100, 255, 0.12), transparent 62%), #1e1830; }

/* 加了广告之后这一屏的瓶颈是高度，而 rpx 只按屏幕宽换算、管不了高。
   所以凡是吃高度的尺寸一律改成 vh：矮屏自动缩、高屏自动放，永远一屏装得下。
   横向尺寸（头像大小、左右留白）仍用 rpx。 */
.container { padding: 1.4vh 28rpx calc(env(safe-area-inset-bottom) + 1.4vh); }

/* ── 顶部：剧本名 + 房间号大字 + 旁白 ── */
.rm-script { text-align: center; font-size: 2.6vh; font-weight: 700; color: #fff; margin-top: 0.4vh; letter-spacing: 4rpx; }
.codebox { text-align: center; margin: 1.6vh 0 0; }
.code-lab { font-size: 1.4vh; letter-spacing: 1vh; color: #8a7fa6; }
.code-big {
  font-size: 7.6vh; font-weight: 900; letter-spacing: 0.6vh; color: #fff; line-height: 1.1;
  text-shadow: 0 0 50rpx rgba(140, 100, 255, 0.45);
}
.rm-narr { text-align: center; font-size: 1.7vh; color: #b3a6cc; margin-bottom: 1.6vh; }

/* ── 玩家网格：不包卡片，头像居中 ── */
.rm-players { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.6vh 30rpx; margin: 0; }
.player { position: relative; width: 120rpx; text-align: center; }
.avatar {
  position: relative;
  width: 96rpx; height: 96rpx; line-height: 96rpx; margin: 0 auto;
  border-radius: 50%; font-size: 40rpx; color: #fff; overflow: visible;
  background: linear-gradient(135deg, #7b5cff, #c44dff);
}
.avatar .avatar-img { width: 96rpx; height: 96rpx; display: block; border-radius: 50%; }
.pname { font-size: 24rpx; margin-top: 0.7vh; color: #ddd6ee; line-height: 1.3; word-break: break-all; }
.pname-dim { color: #8a7fa6; }

/* 已准备/主持人：紫圆勾章，盖头像右上角 */
.okmark {
  position: absolute; right: -6rpx; top: -6rpx; z-index: 2;
  width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center;
  border-radius: 50%; font-size: 22rpx; color: #fff;
  background: linear-gradient(135deg, #7b5cff, #c44dff);
  border: 2rpx solid #1e1830;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

/* 空位：虚线圈 */
.avatar.slot-empty {
  background: none; border: 2rpx dashed rgba(255, 255, 255, 0.25);
  color: #8a7fa6; font-size: 34rpx; box-sizing: border-box;
}

/* 主持人角标 */
.host-badge {
  position: absolute; top: -14rpx; left: 50%; transform: translateX(-50%);
  font-size: 18rpx; white-space: nowrap; z-index: 3;
  background: #ffb347; color: #3a2a00; border-radius: 999rpx; padding: 2rpx 12rpx;
}

.center { text-align: center; }
.warn { color: #ffb347; }
.rm-count { margin-top: 1.2vh; font-size: 1.7vh; }

/* ── 按钮：主按钮紫渐变（全局），整宽 ── */
.btn { width: 100% !important; box-sizing: border-box; margin: 1.4vh 0 0;
  padding: 1.9vh 0; font-size: 2vh; }
.start-btn { margin-top: 1.6vh; padding: 2.2vh 0; font-size: 2.2vh; }
/* 不可用态：仍可点击，点击提示差什么 */
.btn-dim { opacity: 0.55; }

/* 次要操作（解散/退出）：矮一档 */
.btn-slim { padding: 1.2vh 0; font-size: 1.8vh; }

/* 中途退出、由机器人托管的位置 */
.bot-tag {
  margin-left: 8rpx; padding: 0 8rpx; border-radius: 6rpx;
  font-size: 20rpx; color: #b3a6cc; background: rgba(255,255,255,0.10);
}

/* 流量主广告：跟玩家列表留点距离，拉不到广告时整块不占位 */
.rm-ad { display: block; margin: 1.6vh 0 0; }
